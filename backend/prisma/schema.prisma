generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GuestQuery {
  id         Int      @id @default(autoincrement())
  guestName  String
  query      String
  status     String
  createdAt  DateTime @default(now())
}